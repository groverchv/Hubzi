# Hubzy Backend Environment Variables
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=hubzy_db

# Qdrant
QDRANT_URL=
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# IA
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Auth — OBLIGATORIO cambiar en producción (openssl rand -hex 32)
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Entorno y seguridad
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
SENTRY_DSN=
RATE_LIMIT_ENABLED=true

# Recursos de crisis (JSON array, opcional)
# CRISIS_RESOURCES_JSON=[{"name":"Línea de ayuda","phone":"800-XX-XXXX","type":"hotline"}]
